{
  "expo": {
    "name": "Ghost Mode",
    "slug": "ghost-mode-dev-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ghostmode",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.ghostmode.devsys" },
    "android": { "package": "com.ghostmode.devsys", "edgeToEdgeEnabled": true },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true }
  }
}
