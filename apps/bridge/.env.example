# ─── Bridge ─────────────────────────────────────────────────────────────
BRIDGE_PORT=8787
BRIDGE_HOST=127.0.0.1

# ─── Upstream AI API ────────────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint works here.
AI_BASE_URL=https://api.deepseek.com
AI_CHAT_PATH=/v1/chat/completions
AI_API_KEY=sk-REPLACE_ME
AI_DEFAULT_MODEL=deepseek-chat

# ─── Cookie vault ───────────────────────────────────────────────────────
# Where the bridge reads the session cookie file from on each request.
COOKIE_FILE_PATH=/data/data/com.termux/files/home/cookies/session.json
# Where the bridge copies it to before use (working copy).
COOKIE_WORKING_PATH=/data/data/com.termux/files/home/.bridge-cookies/session.json

# ─── Truth Ledger ───────────────────────────────────────────────────────
LEDGER_ARCH_PATH=./logs/truth-ledger-architecture.log
LEDGER_EVENT_PATH=./logs/truth-ledger-events.log

# ─── GitHub (used by scripts/create_repo_and_push.sh and src/githubApi.js) ─
GITHUB_USERNAME=
GITHUB_TOKEN=
DESIRED_REPO_NAME=ai-factory-bridge-backend
GITHUB_REPO_VISIBILITY=private
