{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/index.ts",
    "../../packages/core/src/config/**/*.ts",
    "../../packages/core/src/shared/**/*.ts",
    "../../packages/core/src/ledger/**/*.ts",
    "../../packages/core/src/clients/**/*.ts",
    "../../packages/core/src/orchestrator/**/*.ts",
    "../../packages/core/src/termux-server/**/*.ts",
    "../../packages/core/src/projects/**/*.ts",
    "../../packages/core/src/tasks/**/*.ts",
    "../../packages/core/src/agents/**/*.ts",
    "../../packages/core/src/goals/**/*.ts",
    "../../packages/core/src/offers/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/routes/**",
    "../../packages/core/src/engines/**"
  ]
}
